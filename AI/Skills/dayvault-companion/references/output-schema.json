{
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "skillVersion",
      "goalID",
      "text",
      "sourceIDs",
      "memoryCandidate"
    ],
    "properties": {
      "skillVersion": {
        "type": "string",
        "enum": [
          "1.0.0"
        ]
      },
      "goalID": {
        "type": "string",
        "format": "uuid"
      },
      "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      },
      "sourceIDs": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "memoryCandidate": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 200
      }
    }
  }
}
