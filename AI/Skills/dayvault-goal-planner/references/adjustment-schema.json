{
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "skillVersion",
      "goalID",
      "summary",
      "changes",
      "sourceIDs"
    ],
    "properties": {
      "skillVersion": {
        "type": "string",
        "enum": [
          "1.0.0"
        ]
      },
      "goalID": {
        "type": "string",
        "format": "uuid"
      },
      "summary": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      },
      "changes": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "occurrenceID",
            "newStart"
          ],
          "properties": {
            "occurrenceID": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "newStart": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      },
      "sourceIDs": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    }
  }
}
