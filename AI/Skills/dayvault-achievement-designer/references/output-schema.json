{
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "skillVersion",
      "goalID",
      "achievements"
    ],
    "properties": {
      "skillVersion": {
        "type": "string",
        "enum": [
          "1.0.0"
        ]
      },
      "goalID": {
        "type": "string",
        "format": "uuid"
      },
      "achievements": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "detail",
            "ruleType",
            "target",
            "isHidden",
            "clue",
            "badgeStyleKey",
            "sourceIDs"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "detail": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "ruleType": {
              "type": "string",
              "enum": [
                "completionCount",
                "activeDays",
                "completedCycles"
              ]
            },
            "target": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "isHidden": {
              "type": "boolean"
            },
            "clue": {
              "type": "string",
              "maxLength": 120
            },
            "badgeStyleKey": {
              "type": "string",
              "enum": [
                "crest",
                "orbit",
                "steps",
                "spark",
                "ribbon"
              ]
            },
            "sourceIDs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        }
      }
    }
  }
}
