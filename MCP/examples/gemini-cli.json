{
  "mcpServers": {
    "dayvault": {
      "command": "/absolute/path/to/node",
      "args": ["/absolute/path/to/DayVault/MCP/src/server.mjs", "--snapshot", "/absolute/path/to/private/snapshot.json", "--outbox", "/absolute/path/to/private/outbox"],
      "timeout": 30000,
      "trust": false
    }
  }
}
